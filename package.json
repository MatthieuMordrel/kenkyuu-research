{
  "name": "base-repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "./scripts/setup.sh",
    "kill-ports": "./scripts/kill-dev-ports.sh",
    "dev": "bun run kill-ports && concurrently --kill-others-on-fail --names 'WEB,CONVEX' --prefix-colors 'blue,magenta' 'bun run dev:web' 'bun run dev:convex'",
    "dev:web": "bun run --filter @repo/web dev",
    "dev:convex": "bun run --filter @repo/convex dev",
    "build:web": "bun run --filter @repo/web build",
    "start:web": "bunx serve apps/web/dist -s -l ${PORT:-3000}",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .; OXLINT=$?; bun run lint:single-convex-export; SCE=$?; bun run lint:convex-internal-name; CIN=$?; exit $((OXLINT || SCE || CIN))",
    "lint:oxlint": "oxlint .",
    "lint:single-convex-export": "bun run scripts/lint/rules/single-convex-export.ts",
    "lint:convex-internal-name": "bun run scripts/lint/rules/convex-internal-name.ts",
    "lint:fix": "oxlint --fix .",
    "deps:check": "bun outdated --recursive",
    "deps:update": "bun update --filter '*'"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260415.1",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "serve": "^14.2.6",
    "typescript": "^5.9.3"
  },
  "catalog": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "convex": "^1.35.1",
    "typescript": "^5.9.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
